# Copy to .env for local runs, or set these as environment variables on the Launch project.
# Values come from the stack: Settings > Tokens (delivery + preview token) and the environment name.
VITE_CONTENTSTACK_API_KEY=
VITE_CONTENTSTACK_DELIVERY_TOKEN=
VITE_CONTENTSTACK_PREVIEW_TOKEN=
VITE_CONTENTSTACK_ENVIRONMENT=
VITE_CONTENTSTACK_BRANCH=main
# Region hosts, e.g. eu-cdn.contentstack.com and https://eu-app.contentstack.com
VITE_CONTENTSTACK_API_HOST=
VITE_CONTENTSTACK_APP_HOST=
